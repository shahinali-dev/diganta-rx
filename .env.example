# PostgreSQL connection string (Prisma format)
# Matches docker-compose.yml credentials below — change if you edit that file
DATABASE_URL="postgresql://diganta:diganta123@localhost:5432/diganta_rx?schema=public"

PORT=5000
NODE_ENV=development

SALT_ROUNDS=10

JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRE_IN=1d

JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRE_IN=7d

CORS_ORIGIN=http://localhost:3000
